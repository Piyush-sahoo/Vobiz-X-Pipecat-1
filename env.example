# --- Bot mode ---
# cascaded : Deepgram STT -> Gemini LLM -> Deepgram TTS. Three services you
#            can swap independently, and you get a transcript of both sides.
# realtime : Gemini Live speech-to-speech. One service, roughly 1.5s lower
#            turnaround, no local transcript.
BOT_MODE=cascaded


# --- Vobiz account (required) ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=

# The Vobiz number outbound calls are placed FROM (caller ID). Used by
# /start when "from_number" is not in the request body.
VOBIZ_PHONE_NUMBER=


# --- AI providers ---
# Gemini API key. Required in both modes: the LLM in cascaded mode, the
# speech-to-speech model in realtime mode.
GOOGLE_API_KEY=

# Deepgram API key. Required for BOT_MODE=cascaded (STT + TTS).
DEEPGRAM_API_KEY=

# Cascaded mode: the text model. Must be one your key can access -- newer
# keys cannot use pre-3.x models and will return HTTP 404.
GEMINI_MODEL=gemini-3.6-flash

# Cascaded mode: Deepgram voice.
DEEPGRAM_VOICE=aura-2-thalia-en

# Realtime mode: must be a model advertising bidiGenerateContent, with the
# "models/" prefix.
GEMINI_LIVE_MODEL=models/gemini-3.8-live

# Realtime mode: Gemini Live voice (Charon, Puck, Kore, Fenrir, Aoede).
GEMINI_VOICE=Charon


# --- Vobiz wire format ---
# Must match what server.py advertises in <Stream contentType>. The
# serializer also re-negotiates from Vobiz's `start` event at runtime if
# these disagree.
# Encodings:  audio/x-mulaw | audio/x-l16
# Rates (Hz): 8000 | 16000
VOBIZ_ENCODING=audio/x-mulaw
VOBIZ_SAMPLE_RATE=8000

# L16 byte order on the wire. RFC 2586 specifies "be" (big-endian), but
# some Vobiz accounts transport L16 little-endian -- if L16 frames arrive
# at the right size yet produce no transcripts, set this to "le". Ignored
# for audio/x-mulaw.
VOBIZ_L16_ENDIAN=le


# --- Deployment ---
# local | production
ENV=local

# The public https:// URL where Vobiz reaches your /answer endpoint. The
# answer XML is built from this, so update it whenever your tunnel URL
# changes and restart the server.
PUBLIC_URL=

# Only required when ENV=production: the public wss:// URL hosting the bot.
VOBIZ_PROD_WS_URL=


# --- Human transfer ---
# Required if you use /transfer-to-human or /initiate-transfer. There is no
# default; the server returns HTTP 500 if a transfer is attempted unset.
TRANSFER_AGENT_NUMBER=


# --- Recording (optional) ---
ENABLE_RECORDING=true
MAX_RECORDING_LENGTH=3600


# --- Pipecat Cloud (only when ENV=production) ---
AGENT_NAME=
ORGANIZATION_NAME=
